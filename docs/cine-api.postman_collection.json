{
  "info": {
    "name": "GestionDeCine API",
    "description": "Requests de ejemplo de la API REST de GestionDeCine (TPO Aplicaciones Interactivas). Cambiar la variable baseUrl si el servidor corre en otro equipo o puerto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fechas relativas a hoy, para que las funciones creadas siempre sean futuras.",
          "const f = d => { const x = new Date(); x.setDate(x.getDate() + d); return x.toISOString().slice(0, 10); };",
          "pm.collectionVariables.set('manana', f(1));",
          "pm.collectionVariables.set('dia5', f(5));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "ticketId",
      "value": "1"
    },
    {
      "key": "manana",
      "value": ""
    },
    {
      "key": "dia5",
      "value": ""
    }
  ],
  "item": [
