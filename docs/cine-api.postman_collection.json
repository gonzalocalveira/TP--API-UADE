              "mode": "raw",
              "raw": "{\n  \"usuarioId\": 1,\n  \"funcionId\": 1,\n  \"asientoIds\": [\n    1,\n    2\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('ticketId', pm.response.json().id);"
                ]
              }
            }
          ]
